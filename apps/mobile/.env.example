# Copier vers .env puis relancer avec « npx expo start -c » : Expo met les
# variables en cache et ne les relit pas sans ce drapeau.
#
# Ces deux valeurs se trouvent dans Supabase > Project Settings > API Keys.
# Le format « sb_publishable_… » et l'ancien format « eyJ… » fonctionnent
# tous les deux.
#
# La clé secrète (service_role) n'a RIEN à faire ici : tout ce qui est dans
# une application mobile est lisible par n'importe qui.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
