# Netlify sert le manifeste en application/octet-stream faute de connaitre
# l'extension .webmanifest. Chrome s'en accommode, Safari est plus strict :
# on le declare explicitement pour que l'installation fonctionne sur iPhone.
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

# Le service worker ne doit jamais etre servi depuis un cache : c'est lui qui
# porte la version de l'application, et un cache le figerait.
/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Le type qui declenche l'installateur d'Android plutot qu'un telechargement
# anonyme. Content-Disposition force un nom de fichier lisible dans la liste
# des telechargements du telephone.
/2pg-pointage.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="2pg-pointage.apk"
