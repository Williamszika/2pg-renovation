# Supabase > Project Settings > API Keys
#
# Supabase délivre désormais des clés au format « sb_publishable_… » et
# « sb_secret_… ». Les anciens projets ont des clés en « eyJ… » (des JWT) :
# les deux formats fonctionnent, prenez simplement celles que votre projet
# affiche.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé publique (« anon » ou « publishable »). Elle est faite pour être
# distribuée : elle ne donne accès qu'à ce que les règles de sécurité autorisent.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Clé secrète (« service_role » ou « secret »). Elle contourne TOUTES les règles
# de sécurité et donne un accès total à la base.
#   - uniquement côté serveur, jamais préfixée NEXT_PUBLIC_
#   - jamais dans l'application mobile
#   - jamais commitée
# Elle ne sert qu'à créer les comptes des ouvriers.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx
